url: "https://github.com/hegazi-sec/ClaudeBar"
license: Apache-2.0
version: "1.0.0"
date-released: "2026-11-25"
keywords:
  - macOS
  - menu bar
  - Swift
  - AppKit
  - Anthropic Claude
  - Claude Code
  - usage limits
  - rate limits
  - open source
